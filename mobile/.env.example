# Mobile app environment. Copy to `.env`. Never put secrets here.
#
# EXPO_PUBLIC_* values are inlined into the JavaScript bundle at build time,
# so treat them as public knowledge.
#
# 127.0.0.1 works only when the app runs on the same machine as the backend (web/emulator).
# On a real phone use the laptop's LAN IP, or its Tailscale IP with `tailscale ip -4`.
EXPO_PUBLIC_API_URL=http://100.113.70.49:8787
