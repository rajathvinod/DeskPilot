{
  "expo": {
    "name": "DeskPilot",
    "slug": "deskpilot",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "deskpilot",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "DeskPilot turns your speech into a task so you do not have to type it.",
        "NSMicrophoneUsageDescription": "DeskPilot uses the microphone only while you are holding the talk button."
      }
    },
    "android": {
      "package": "com.deskpilot.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#208AEF"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "DeskPilot uses the microphone only while you are holding the talk button.",
          "speechRecognitionPermission": "DeskPilot turns your speech into a task so you do not have to type it."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "21a8e19a-4281-4e64-a168-998dc801be35"
      }
    }
  }
}
