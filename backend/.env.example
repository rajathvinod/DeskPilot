# Backend environment. Copy to `.env` and adjust. Never commit `.env`.
#
# All app variables are prefixed DP_ so they cannot be clobbered by unrelated tools
# that export generic names like PORT or HOST (which win over .env values).
NODE_ENV=development
DP_HOST=127.0.0.1
DP_PORT=8787
DP_LOG_LEVEL=info

# Shared secret the agent presents on /agent/ws. Must match agent/.env.
# Empty means "no check" — the backend logs a warning at startup when this is unset.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# DP_AGENT_TOKEN=
# Where the device registry lives (relative to backend/). Holds token hashes, never tokens.
# DP_STATE_DIR=.state

# How many minutes a pairing code stays valid (default 30, clamped 1-240). Single use either
# way, and burned after five wrong guesses.
# DP_PAIR_TTL_MIN=30
