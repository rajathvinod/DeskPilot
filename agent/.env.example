# Agent environment. Copy to `.env` and adjust. Never commit `.env`.
#
# All variables are prefixed DP_ so they cannot be clobbered by unrelated tools that
# export generic names like PORT or HOST (OS env wins over .env).
DP_HOST=127.0.0.1
DP_PORT=8788
DP_LOG_LEVEL=info

# Where the agent dials out to (Milestone 2b). http:// or https://; the agent derives
# ws:// or wss:// from it and connects to /agent/ws.
# Leave empty to run the agent standalone (local HTTP only, no backend connection).
DP_BACKEND_URL=http://127.0.0.1:8787

# Shared secret for /agent/ws. Must match DP_AGENT_TOKEN in backend/.env, otherwise the
# backend closes the socket (code 4003) before it reads a single message.
# DP_AGENT_TOKEN=

# Heartbeat: ping every interval; no reply within the timeout means "degraded".
DP_HEARTBEAT_INTERVAL_S=10
DP_HEARTBEAT_TIMEOUT_S=5

# Reconnect backoff: 1s, 2s, 4s, 8s, 16s, capped at 30s, with jitter.
DP_BACKOFF_BASE_S=1
DP_BACKOFF_MAX_S=30

# Milestone 12: foreground-window sampling for the audit trail. The agent reads the process
# name and window title only — never keystrokes, clipboard or pixels. A report is sent when the
# window changes, and once per report interval when nothing has changed (so a silent monitor is
# distinguishable from an idle laptop).
DP_ACTIVITY_INTERVAL_S=3
DP_ACTIVITY_REPORT_S=60
